<Window x:Class="Clawdy.Windows.UI.CardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clawdy" Width="324" Height="176" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="Clawdy status details">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#914A36"/>
            <Setter Property="Foreground" Value="#FFF0DC"/>
            <Setter Property="BorderBrush" Value="#40E1946D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#FFF0DC"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="CardRoot" CornerRadius="20" Background="#F2191C23" BorderBrush="#35FFFFFF"
            BorderThickness="1.2" RenderTransformOrigin="0.5,0">
        <Border.RenderTransform><ScaleTransform x:Name="RevealScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
        <Grid Margin="18,12,18,12" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title & Close -->
                <RowDefinition Height="*"/>    <!-- Body: Text + Mascot -->
                <RowDefinition Height="Auto"/> <!-- Action / Hint -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Row 0: Top Header -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="Clawdy" Foreground="#E1946D" FontSize="11.5" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button x:Name="CloseButton" Width="24" Height="24" Content="×"
                        FontSize="17" Background="Transparent" BorderBrush="Transparent" Foreground="#AFFFFFFF"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        AutomationProperties.Name="Dismiss status details" ToolTip="Dismiss. Escape when keyboard focused."/>
            </Grid>

            <!-- Row 1: Middle Body (Heading + Summary on left, Mascot on right) -->
            <Grid Grid.Row="1" Margin="0,2,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="HeadingText" Foreground="#FFFDFC" FontSize="15.5" FontWeight="SemiBold"
                               TextWrapping="Wrap" LineHeight="19"/>
                    <TextBlock x:Name="SummaryText" Foreground="#EDC26E" FontSize="11" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Clawdy Brand Mascot Illustration (Well-fitted 60x60 container with high-quality rendering) -->
                <Border Grid.Column="1" Width="60" Height="60" CornerRadius="14" Background="#F5E8D4"
                        VerticalAlignment="Center">
                    <Grid Margin="4">
                        <Image x:Name="ProductImage" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="Clawdy product illustration"/>
                        <TextBlock x:Name="ProductFallback" Text="C" FontSize="26" FontWeight="Bold" Foreground="#E1946D"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 2: Action Buttons / Hint Text -->
            <Grid Grid.Row="2" Margin="0,0,0,4" MinHeight="26">
                <StackPanel x:Name="ActionRow" Orientation="Horizontal" VerticalAlignment="Center"/>
                <TextBlock x:Name="HintText" FontSize="11" Foreground="#B9BAC0" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Row 3: Footer Text -->
            <TextBlock x:Name="FooterText" Grid.Row="3" FontSize="10" Foreground="#A3A7B0"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
